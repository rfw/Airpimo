{
  "name": "airpimo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Airpimo — cross-platform AirPlay receiver powered by UxPlay",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:source": "node scripts/source-check.mjs",
    "check": "npm run test && npm run test:source && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/check-native.mjs && tauri build",
    "native:stage": "node scripts/stage-native.mjs",
    "check:rust-lock": "node scripts/check-tauri-lock.mjs",
    "verify:mac": "bash scripts/verify-macos.sh",
    "native:doctor": "node scripts/desktop-dev.mjs --doctor",
    "native:audit:mac": "node scripts/audit-macos-native.mjs",
    "native:verify:app": "node scripts/verify-app-bundle.mjs",
    "desktop:build:mac": "node scripts/check-native.mjs && npm run test && npm run test:source && npx tauri build --target x86_64-apple-darwin --bundles dmg && npm run native:verify:app",
    "native:relocate:mac": "node scripts/relocate-macos-native.mjs",
    "native:prune:mac": "node scripts/prune-macos-native.mjs",
    "native:prepare": "node scripts/native-engine.mjs prepare",
    "native:status": "node scripts/native-engine.mjs status",
    "native:export": "node scripts/native-export.mjs",
    "native:bundle:prepare": "node scripts/native-bundle.mjs prepare",
    "native:verify:release": "node scripts/check-native.mjs",
    "native:bundle:status": "node scripts/native-bundle.mjs status",
    "native:bundle:import": "node scripts/native-bundle.mjs import",
    "native:bundle:export": "node scripts/native-bundle.mjs export",
    "native:bundle:stage": "node scripts/native-bundle.mjs stage",
    "native:bundle:from-build": "node scripts/native-release-prepare.mjs",
    "native:bundle:prepare:win7": "node scripts/native-release-prepare.mjs --win7",
    "native:bundle:prepare-from-source": "node scripts/native-release-prepare.mjs",
    "desktop:build:win7": "node scripts/build-win7.mjs",
    "desktop:build:win10": "node scripts/build-win10.mjs",
    "native:verify:win7": "node scripts/check-native.mjs --win7",
    "native:mdns:pin:win7": "node scripts/win7-mdns-engine.mjs pin",
    "native:mdns:build:win7": "node scripts/win7-mdns-engine.mjs build",
    "native:bundle:prepare:win7:mdns": "node scripts/win7-mdns-stage.mjs",
    "native:verify:win7:mdns": "node scripts/check-native.mjs --win7 --require-mdns",
    "desktop:build:win7:mdns": "node scripts/build-win7.mjs --require-mdns",
    "ci:native:export": "node scripts/ci-native-release.mjs export",
    "ci:native:stage": "node scripts/ci-native-release.mjs stage",
    "ci:selfhost:stage": "node scripts/ci-selfhost-stage.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-switch": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfw/Airpimo.git"
  }
}
