{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airpimo",
  "version": "0.1.0",
  "identifier": "com.airpimo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Airpimo",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 360,
        "height": 560,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#20232A"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "publisher": "rfw",
    "targets": ["nsis"],
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/sidecar/": "sidecar/",
      "resources/gstreamer/": "gstreamer/",
      "resources/native-manifest.json": "native-manifest.json",
      "resources/fullscreen/": "fullscreen/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "startMenuFolder": "Airpimo",
        "installerIcon": "icons/installer.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
